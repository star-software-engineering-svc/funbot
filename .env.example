# funbot .env: the account, the strategy name, feeds, plumbing and secrets. The strategy's own parameters live in
# config/strategy/<name>.py (FAIRV1_*); a shell variable of a key overrides one run.

# ---- account ---------------------------------------------------------------
DRY_RUN=true                        # true = simulate fills against the live predict.fun book, no wallet needed
STRATEGY=fairv1                     # the one strategy this process runs (logs in LOG_DIR/<strategy>/)
PREDICT_ENV=mainnet                 # mainnet (api.predict.fun, BNB Chain) | testnet (api-testnet.predict.fun, no API key)
PREDICT_API_KEY=                    # mainnet: x-api-key from developers.predict.fun (also for the websocket)
PREDICT_PRIVATE_KEY=                # live only: the signer key (an EOA; or the Privy wallet key of a Predict account)
PREDICT_ACCOUNT=                    # live only: the Predict smart-wallet (deposit) address when trading from one; empty = the EOA

# ---- the strategy's switch -------------------------------------------------
FAIRV1_RUN=true

# ---- market ----------------------------------------------------------------
MARKET_PREFIX=btc-updown-5m         # predict.fun round slugs <prefix>-<window start>

# ---- resolution price ------------------------------------------------------
# predict.fun's BTC 5m rounds resolve on the Chainlink Data Streams BTC/USDT stream (topofbook-datalink): the mid of
# Binance's BTCUSDT top of book. Without Data Streams keys the bot reads that mid from Binance directly.
PRICE_SOURCE=auto                   # auto (Chainlink while fresh, else Binance) | chainlink | binance
BINANCE_SYMBOL=btcusdt              # Binance SPOT bookTicker
CHAINLINK_FEED_ID=0x000366e0ccc605d3b7f096c33d6ecf1cd27ebd7fdc4f94e22b577e44e0a295a5
CHAINLINK_API_KEY=                  # Chainlink Data Streams credentials (empty = no Chainlink feed)
CHAINLINK_API_SECRET=
CHAINLINK_WS_URL=wss://ws.dataengine.chain.link
COINBASE_FEED=true                  # comparison only (coinbase.csv, status line)
COINBASE_PRODUCT=BTC-USD
SETTLE_BAND_USD=5.0                 # our end price this close to the beat: the settler waits for predict.fun's result

# ---- dry-run ---------------------------------------------------------------
DRY_RUN_LATENCY_MS=300

# ---- plumbing --------------------------------------------------------------
LOG_DIR=output/logs                 # LOG_DIR/<strategy>/<YYYYMMDD>/
MAX_LOG_PERIOD=100
STATUS_EVERY_S=1
DISCOVERY_EVERY_S=20
